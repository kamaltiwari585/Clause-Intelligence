# gemini | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6KlLUJQU2UjomttNirkpMla57LNu2VHc0dNRvObt08odA
GEMINI_MODEL=gemini-flash-latest
